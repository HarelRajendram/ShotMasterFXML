<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.shotmasterfxml.Controllers.LevelScreenController">
    
   <children>
      <GridPane fx:id="buttonGrid" alignment="CENTER" gridLinesVisible="true" layoutX="118.0" layoutY="98.0" prefHeight="248.0" prefWidth="364.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Button alignment="CENTER" mnemonicParsing="false" text="Level 1" GridPane.halignment="CENTER" GridPane.valignment="CENTER" />
            <Button alignment="CENTER" mnemonicParsing="false" text="Level 2" GridPane.columnIndex="1" GridPane.halignment="CENTER" />
            <Button alignment="CENTER" mnemonicParsing="false" text="Level 3" GridPane.columnIndex="2" GridPane.halignment="CENTER" />
            <Button alignment="CENTER" mnemonicParsing="false" text="Level 4" GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER" />
            <Button alignment="CENTER" mnemonicParsing="false" text="Level 5" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER" />
            <Button alignment="CENTER" mnemonicParsing="false" text="Level 6" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
            <Button alignment="CENTER" mnemonicParsing="false" text="Level 7" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
            <Button mnemonicParsing="false" text="Level 8" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
            <Button alignment="CENTER" mnemonicParsing="false" text="Level 9" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
            <Button mnemonicParsing="false" text="Level 10" GridPane.halignment="CENTER" GridPane.rowIndex="3" />
            <Button mnemonicParsing="false" text="Level 11" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="3" />
            <Button alignment="CENTER" mnemonicParsing="false" text="Level 12" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="3" />
         </children>
         <opaqueInsets>
            <Insets top="10.0" />
         </opaqueInsets>
      </GridPane>
      <Label alignment="CENTER" layoutX="240.0" layoutY="44.0" prefHeight="18.0" prefWidth="120.0" text="Pick a level" />
      <Button fx:id="backButton" layoutX="54.0" layoutY="31.0" mnemonicParsing="false" onAction="#onBackButtonPressed" text="BACK" />
   </children>
</AnchorPane>
