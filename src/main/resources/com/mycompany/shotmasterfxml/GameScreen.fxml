<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainContainer" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="725.0" prefWidth="1138.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.shotmasterfxml.Controllers.GameScreenController">
   <bottom>
      <HBox prefHeight="130.0" prefWidth="200.0" spacing="5.0" BorderPane.alignment="CENTER">
         <children>
            <VBox prefHeight="130.0" prefWidth="153.0" spacing="15.0">
               <children>
                  <Label prefHeight="23.0" prefWidth="192.0" text="Angle :" translateX="10.0" translateY="30.0" />
                  <Label prefHeight="18.0" prefWidth="68.0" text="Velocity :" translateX="10.0" translateY="30.0" />
               </children>
            </VBox>
            <VBox layoutX="318.0" layoutY="10.0" prefHeight="100.0" prefWidth="177.0">
               <children>
                  <Slider fx:id="angleSlider" onDragDetected="#onAngleDrag" prefHeight="22.0" prefWidth="177.0" translateX="-50.0" translateY="33.0" />
                  <Slider fx:id="velocitySlider" onDragDetected="#onVelocityDrag" prefHeight="22.0" prefWidth="177.0" translateX="-50.0" translateY="45.0" />
               </children>
            </VBox>
            <VBox layoutX="80.0" layoutY="10.0" prefHeight="89.0" prefWidth="75.0" translateX="-45.0">
               <children>
                  <TextField fx:id="angleTextField" prefHeight="29.0" prefWidth="75.0" translateY="30.0" />
                  <TextField fx:id="velocityTextField" prefHeight="32.0" prefWidth="75.0" translateY="28.0" />
               </children>
            </VBox>
            <Button fx:id="backButton" mnemonicParsing="false" onAction="#onBackButtonPressed" text="BACK" />
            <Button fx:id="startButton" mnemonicParsing="false" onAction="#onStartButtonPressed" scaleX="2.0" scaleY="2.0" text="START" translateX="600.0" translateY="50.0">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </bottom>
   <right>
      <VBox fx:id="goalStats" prefHeight="200.0" prefWidth="150.0" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="CENTER" scaleX="2.0" scaleY="2.0" text="Stats" translateX="30.0" translateY="20.0" />
            <Label alignment="CENTER" layoutX="10.0" layoutY="10.0" text="Distance" translateY="40.0" />
            <Label fx:id="distanceLabel" text="Label" translateY="45.0" />
            <Label alignment="CENTER" layoutX="10.0" layoutY="10.0" text="Height" translateY="50.0" />
            <Label alignment="CENTER" layoutX="10.0" layoutY="28.0" text="Goal" translateY="60.0" />
         </children>
      </VBox>
   </right>
