<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainContainer" prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.shotmasterfxml.Controllers.GameScreenController">
    <stylesheets>
        <URL value="@styles/levelscreen.css" />
    </stylesheets>
    
    <center>
        <AnchorPane fx:id="gameField" prefHeight="400.0" prefWidth="600.0" BorderPane.alignment="CENTER">
            <children>
                <Rectangle arcHeight="5.0" arcWidth="5.0" height="146.0" layoutX="429.0" layoutY="152.0" opacity="0.22" stroke="BLACK" strokeType="INSIDE" width="157.0" />
                
                <Circle fx:id="ballSphere" layoutX="67.0" layoutY="268.0" radius="15.0" fill="RED" />
                
                <Label layoutX="462.0" layoutY="88.0" prefHeight="50.0" prefWidth="124.0" text="GOAL">
                    <font>
                        <Font name="Noteworthy Bold" size="29.0" />
                    </font>
                </Label>
            </children>
        </AnchorPane>
    </center>

    <bottom>
        <AnchorPane prefHeight="100.0" prefWidth="800.0" BorderPane.alignment="CENTER">
            <children>
                <Label layoutX="20.0" layoutY="20.0" text="Angle :" />
                <Slider fx:id="angleSlider" layoutX="70.0" layoutY="21.0" max="90.0" />
                <TextField fx:id="angleTextField" layoutX="220.0" layoutY="16.0" prefHeight="26.0" prefWidth="60.0" />

                <Label layoutX="20.0" layoutY="60.0" text="Velocity :" />
                <Slider fx:id="velocitySlider" layoutX="70.0" layoutY="61.0" max="50.0" />
                <TextField fx:id="velocityTextField" layoutX="220.0" layoutY="56.0" prefHeight="26.0" prefWidth="60.0" />

                <Button fx:id="startButton" layoutX="500.0" layoutY="30.0" mnemonicParsing="false" onAction="#onStartButtonPressed" text="START" />
                <Button fx:id="backButton" layoutX="320.0" layoutY="30.0" mnemonicParsing="false" onAction="#onBackButtonPressed" text="BACK" />
            </children>
        </AnchorPane>
    </bottom>

    <right>
        <VBox fx:id="goalStats" alignment="TOP_RIGHT" prefHeight="400.0" prefWidth="150.0" spacing="10.0" style="-fx-padding: 20;" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-font-weight: bold; -fx-font-size: 16;" text="Stats" />
                <Label text="Distance :" />
                <Label fx:id="distanceLabel" text="0.00" />
                <Label text="Time :" />
                <Label fx:id="timeLabel" text="0.00" />
                <Label text="Height :" />
                <Label fx:id="heightLabel" text="0.00" />
                <Label text="Goal :" />
                <Label fx:id="goalLabel" text="-" />
            </children>
        </VBox>
    </right>
</BorderPane>