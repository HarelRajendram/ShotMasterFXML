<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainContainer" maxHeight="500.0" maxWidth="800.0" prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: #275a34;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.shotmasterfxml.Controllers.GameScreenController">

    <bottom>
        <AnchorPane prefHeight="100.0" prefWidth="800.0" style="-fx-background-color: white;" BorderPane.alignment="CENTER">
            <children>
                <Label layoutX="26.0" layoutY="21.0" style="-fx-background-color: white;" text="Angle :" />
                <Slider fx:id="angleSlider" layoutX="70.0" layoutY="21.0" max="90.0" prefHeight="16.0" prefWidth="200.0" style="-fx-background-color: #1a1e24; -fx-background-radius: 5px; -fx-padding: 0;" />
                <TextField fx:id="angleTextField" layoutX="280.0" layoutY="17.0" prefHeight="26.0" prefWidth="60.0" />

                <Label layoutX="14.0" layoutY="61.0" text="Velocity :" />
                <Slider fx:id="velocitySlider" layoutX="70.0" layoutY="61.0" max="60.0" prefHeight="16.0" prefWidth="200.0" style="-fx-background-color: #1a1e24; -fx-background-radius: 5px; -fx-padding: 0;" />
                <TextField fx:id="velocityTextField" layoutX="280.0" layoutY="56.0" prefHeight="26.0" prefWidth="60.0" />

               <Button fx:id="startButton" layoutX="603.0" layoutY="20.0" mnemonicParsing="false" onAction="#onStartButtonPressed" prefHeight="50.0" prefWidth="108.0" style="-fx-background-color: #1e90ff; -fx-text-fill: white; -fx-background-radius: 10px;" text="SHOOT">
                <font>
                    <Font name="Noteworthy Bold" size="19.0" />
                </font>
            </Button>
                <Button fx:id="backButton" layoutX="498.0" layoutY="30.0" mnemonicParsing="false" onAction="#onBackButtonPressed" prefHeight="30.0" prefWidth="55.0" style="-fx-background-color: grey; -fx-text-fill: white; -fx-background-radius: 5px;" text="BACK" />
            <Button fx:id="resetButton" layoutX="413.0" layoutY="30.0" mnemonicParsing="false" onAction="#onResetButtonPressed" prefHeight="30.0" prefWidth="55.0" style="-fx-background-color: #ffbb00; -fx-background-radius: 5px;" text="Reset" textFill="WHITE" />
            </children>
        </AnchorPane>
    </bottom>

    <right>
        <VBox fx:id="goalStats" prefHeight="400.0" prefWidth="200.0" spacing="10.0" style="-fx-padding: 20; -fx-background-color: white;" BorderPane.alignment="CENTER">
            <children>
                <Label prefHeight="20.0" prefWidth="41.0" style="-fx-font-weight: bold; -fx-font-size: 16;" text="Stats">
               <font>
                  <Font name="System Bold" size="23.0" />
               </font></Label>
                <Label text="Distance :">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font></Label>
                <Label fx:id="distanceLabel" text="0.00">
               <font>
                  <Font size="17.0" />
               </font></Label>
                <Label text="Time :">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font></Label>
                <Label fx:id="timeLabel" text="0.00">
               <font>
                  <Font size="17.0" />
               </font></Label>
                <Label text="Height :">
               <font>
                  <Font name="System Bold Italic" size="20.0" />
               </font></Label>
                <Label fx:id="heightLabel" text="0.00">
               <font>
                  <Font size="17.0" />
               </font></Label>
                <Label text="Goal :">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font></Label>
                <Label fx:id="goalLabel" text="0">
               <font>
                  <Font size="17.0" />
               </font></Label>
            </children>
        </VBox>
    </right>
   <top>
   <Label fx:id="victoryLabel" visible="false" BorderPane.alignment="CENTER">
      <font>
         <Font size="74.0" />
      </font>
   </Label>
</top>
</BorderPane>
